# ---------------------------------------------------------------------------
# Copy this file to .env and fill it in. .env is gitignored; never commit it.
# ---------------------------------------------------------------------------

# Main Supabase project. Dashboard -> Connect -> "Session pooler" -> URI.
#
# Two edits to what you copy:
#   1. postgresql://  ->  postgresql+asyncpg://
#   2. [YOUR-PASSWORD] -> the database password you set when creating the project
#
# Use the SESSION pooler, not the direct connection: direct is IPv6-only on the free
# tier and most home networks are IPv4. If the password contains special characters,
# percent-encode them: @ -> %40, # -> %23, / -> %2F, : -> %3A
DATABASE_URL=postgresql+asyncpg://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# A SECOND, separate Supabase project. The migration round-trip test drops every table
# in this database on every run, so it must never point at the one above.
# Tests needing it are skipped when this is empty.
TEST_DATABASE_URL=

# Supabase -> Project Settings -> API -> JWT Secret. Needed from phase 2 (auth).
SUPABASE_JWT_SECRET=

# themoviedb.org -> Settings -> API -> "API Key (v3 auth)". The short one, not the token.
TMDB_API_KEY=

# aistudio.google.com/apikey - the key of a project with billing enabled (PAID tier: the
# free tier lets Google train on what you send; ADR 0004). Used for trait extraction and
# embeddings. Leave empty until the staged trait run is approved.
GEMINI_API_KEY=

# console.anthropic.com. Not used by the Phase 1 data pipelines; needed for the Phase 4
# assistant. Leave empty until then.
ANTHROPIC_API_KEY=

# Optional in development.
REDIS_URL=

ENV=development
CORS_ORIGINS=http://localhost:5173
