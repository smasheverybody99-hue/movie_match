# Supabase Postgres. Project Settings -> Database -> Connection string (URI).
# Note the +asyncpg driver suffix.
DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# Optional. A throwaway Postgres with pgvector for DB-backed tests and the migration
# round-trip. Tests that need it are skipped when empty. Never point it at real data.
TEST_DATABASE_URL=

# Supabase -> Project Settings -> API -> JWT Secret
SUPABASE_JWT_SECRET=

# themoviedb.org -> Settings -> API
TMDB_API_KEY=

# console.anthropic.com
ANTHROPIC_API_KEY=

# Optional in development
REDIS_URL=redis://localhost:6379/0

ENV=development
CORS_ORIGINS=http://localhost:5173
